# ==============================================================================
# vc-blog 环境变量模板
# ==============================================================================
# 日常开发无需手动复制本文件：
#   1. 首次在新机器上执行 `vercel login && vercel link`
#   2. 运行 `npm run env:pull` 从 Vercel Development 环境一键拉取 .env
#
# 说明：本项目 prisma.config.ts 与 src/lib/db.ts 均通过 dotenv 读取 .env，
# 因此统一拉取到 .env（而非默认的 .env.local）。
# ==============================================================================

# --- 数据库 (PostgreSQL / Neon) ---
# 建议 Development / Preview 使用独立的 Neon dev 分支，避免污染生产数据
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

# --- 管理后台认证 (/admin) ---
VC_ADMIN_PASSWORD="your-admin-password"
JWT_SECRET="your-jwt-secret"

# --- 站点与评论 ---
# Development 可设为 http://localhost:3000，Production 设为正式站点域名
NEXT_PUBLIC_DOMAIN="http://localhost:3000"
NEXT_PUBLIC_DISQUS_SHORTNAME="your-disqus-shortname"

# --- 媒体存储 (Vercel Blob) ---
BLOB_READ_WRITE_TOKEN="vercel_blob_rw_xxxxxxxx"

# --- AI 辅助生成 (Cloudflare AI Gateway + 模型) ---
CLOUDFLARE_ACCOUNT_ID="your-cloudflare-account-id"
CLOUDFLARE_GATEWAY_NAME="your-gateway-name"
CLOUDFLARE_API_KEY="your-cloudflare-api-key"
AI_API_KEY="your-ai-provider-api-key"
AI_MODEL="your-model-name"

# --- Cloudflare Turnstile 人机验证 ---
# Development / Preview 可使用 Cloudflare 官方 Always-Pass 测试密钥：
#   Site Key:   1x00000000000000000000AA
#   Secret Key: 1x0000000000000000000000000000000AA
NEXT_PUBLIC_TURNSTILE_SITE_KEY="1x00000000000000000000AA"
TURNSTILE_SECRET_KEY="1x0000000000000000000000000000000AA"
